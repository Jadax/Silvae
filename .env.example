# Root environment template (all free-tier, still secrets — never commit real values)
# Copy to .env.local (web) / Vercel project env (server) as appropriate.

# --- Web (Vite, build-time, public config is safe) ---
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
VITE_API_BASE=/api

# --- Vercel server env ---
# Photo ID: Plant.id is tried first (richer health data); on quota/unavailable it
# falls back to the free (non-commercial) PlantNet API. No keys yet = the app
# still works, identification just shows a "not set up yet" message.
PLANT_ID_API_KEY=your_free_plantid_key
PLANTNET_API_KEY=your_free_plantnet_key
# PlantNet project string from your free API key (the "all species" project)
PLANTNET_PROJECT=all
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=silvae-photos
FIREBASE_SERVICE_ACCOUNT={ "type": "service_account", ... }
