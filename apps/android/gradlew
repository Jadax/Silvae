#!/bin/sh

# Copyright © 2015-2024 the original authors.
# Licensed under the Apache License, Version 2.0.

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" >/dev/null && pwd -P) || exit

# Keep these unquoted inside the variable: shell quotes are not re-evaluated
# after variable expansion, so embedded quote characters would be passed to
# Java and make every CI invocation fail before Gradle starts.
DEFAULT_JVM_OPTS='-Xmx64m -Xms64m'

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
    die "ERROR: Gradle wrapper JAR is missing: $CLASSPATH"
fi

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD=$JAVA_HOME/bin/java
else
    JAVACMD=java
fi

command -v "$JAVACMD" >/dev/null 2>&1 || die "ERROR: Java is not available. Set JAVA_HOME to JDK 17 or later."

set -- \
        "-Dorg.gradle.appname=$(basename "$0")" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

exec "$JAVACMD" $DEFAULT_JVM_OPTS "$@"
