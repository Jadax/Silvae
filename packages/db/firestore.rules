rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uidField) {
      return signedIn() && resource.data[uidField] == request.auth.uid;
    }
    function isCreator(uidField) {
      return signedIn() && request.resource.data[uidField] == request.auth.uid;
    }
    // Deleting something already gone is a no-op, so a retried offline
    // delete can't get stuck on a permission error.
    function alreadyGone() {
      return signedIn() && resource == null;
    }

    // Canonical species catalog: public read (guest Discover, C-7). Seeded via
    // admin tooling only — no app-path writes.
    match /species/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Disease / symptom knowledge base: public read.
    match /diseases/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Users (schema 7.1): self-scoped.
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Plants (schema 7.1): ownerUid == uid; shared caregivers (S-6) read.
    match /plants/{plantId} {
      allow read: if isOwner('uid') || request.auth.uid in resource.data.sharedWith.uid;
      allow create: if isCreator('uid');
      allow update: if isOwner('uid') && isCreator('uid');
      allow delete: if isOwner('uid') || alreadyGone();
    }

    // Rooms: owner-scoped.
    match /rooms/{roomId} {
      allow read, update, delete: if isOwner('uid');
      allow create: if isCreator('uid');
    }

    // Care events: compact, offline-synced (17.1). Owner-scoped — this is
    // per-plant care history, not public; do not widen to blanket signedIn().
    match /care_events/{eventId} {
      allow read: if isOwner('uid');
      allow create: if isCreator('uid');
      allow update: if isOwner('uid') && isCreator('uid');
      allow delete: if isOwner('uid') || alreadyGone();
    }

    // Journal entries (date, caption, comments, hasImage): owner-scoped.
    match /photos/{photoId} {
      allow read: if isOwner('uid');
      allow create: if isCreator('uid');
      allow update: if isOwner('uid') && isCreator('uid');
      allow delete: if isOwner('uid') || alreadyGone();
    }

    // Journal images, kept apart from the entries so listing a journal never
    // downloads every image. Compressed client-side to stay well under 1 MiB.
    match /photo_blobs/{photoId} {
      allow read: if isOwner('uid');
      allow delete: if isOwner('uid') || alreadyGone();
      allow create, update: if isCreator('uid')
        && (resource == null || isOwner('uid'))
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 900000;
    }

    // Health checks (9.x): owner-scoped.
    match /health_checks/{checkId} {
      allow read, update, delete: if isOwner('uid');
      allow create: if isCreator('uid');
    }

    // Rollups (summary_stats/{plantId_month}): server-maintained only (17.1,
    // 13.1) — client writes would let anyone tamper with stats or fake quota
    // usage. The admin SDK bypasses these rules for the cron/API writer.
    match /summary_stats/{plantId_month} {
      allow read: if signedIn();
      allow write: if false;
    }

    // caches/{key}: any signed-in user may read; writes happen via the server
    // (admin SDK bypasses rules) or app users on cache miss. Document ids are
    // kind-prefixed (`id:{fingerprint}`, `weather:{lat,lon}`).
    match /caches/{key} {
      allow read, write: if signedIn();
    }

    // Share links (S-5/S-6): any signed-in user may read/create (an invitee
    // isn't the creator yet), but only the creator may delete — and no
    // generic update, so a link can't be hijacked to point at a different
    // plant or invitee after creation.
    match /share_links/{token} {
      allow read: if signedIn();
      allow create: if isCreator('createdBy');
      allow delete: if isOwner('createdBy');
    }
  }
}
