{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @silvae/core build && pnpm --filter @silvae/server build && pnpm --filter @silvae/web build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "server/functions/dist/**"
    }
  },
  "regions": [
    "cpt1"
  ]
}
